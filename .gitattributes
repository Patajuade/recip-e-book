# Normalize line endings to LF in the repo and in the working copy,
# regardless of the local core.autocrlf setting.
* text=auto eol=lf

# Windows scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
