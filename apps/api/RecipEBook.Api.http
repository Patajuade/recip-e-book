@RecipEBook.Api_HostAddress = https://localhost:7288

GET {{RecipEBook.Api_HostAddress}}/health/
Accept: application/json

###

# All recipes, most recently updated first
GET {{RecipEBook.Api_HostAddress}}/api/recipes

###

# Case- and accent-insensitive title search
GET {{RecipEBook.Api_HostAddress}}/api/recipes?search=LEGUMES

###

# Filter by tag
GET {{RecipEBook.Api_HostAddress}}/api/recipes?tag=dessert

###

# One recipe (replace the id with one returned by the list); unknown id → 404
GET {{RecipEBook.Api_HostAddress}}/api/recipes/00000000-0000-0000-0000-000000000000

###

# Create a recipe → 201 Created, Location header and { "id": … }
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Omelette aux herbes",
  "servings": 2,
  "prepTimeMinutes": 5,
  "cookTimeMinutes": 5,
  "ingredients": [
    { "name": "œufs", "quantity": 3 },
    { "name": "ciboulette", "quantity": 0.5, "unit": "botte" }
  ],
  "steps": ["Battre les œufs.", "Cuire à feu doux."],
  "tags": ["quick", "vegetarian", "eggs"]
}

###

# Invalid recipe → 400 with the validation errors
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": " ",
  "servings": 0,
  "ingredients": [{ "name": "", "quantity": -1 }],
  "steps": [""]
}

###

# Replace a whole recipe (replace the id) → 204; fields left out become empty; unknown id → 404
PUT {{RecipEBook.Api_HostAddress}}/api/recipes/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Omelette aux fines herbes",
  "servings": 1,
  "ingredients": [{ "name": "œufs", "quantity": 2 }],
  "steps": ["Battre les œufs avec les herbes.", "Cuire 4 minutes à feu doux."],
  "tags": ["quick", "eggs", "breakfast"]
}

###

# Tag outside the catalog → 400 "Unknown tag"
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Test",
  "tags": ["vegetarian", "not-a-tag"]
}

###
