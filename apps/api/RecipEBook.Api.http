@RecipEBook.Api_HostAddress = https://localhost:7288

GET {{RecipEBook.Api_HostAddress}}/health/
Accept: application/json

###

# All recipes, most recently updated first
GET {{RecipEBook.Api_HostAddress}}/api/recipes

###

# Case- and accent-insensitive title search
GET {{RecipEBook.Api_HostAddress}}/api/recipes?search=LEGUMES

###

# Filter by tag
GET {{RecipEBook.Api_HostAddress}}/api/recipes?tag=dessert

###

# One recipe (replace the id with one returned by the list); unknown id → 404
GET {{RecipEBook.Api_HostAddress}}/api/recipes/00000000-0000-0000-0000-000000000000

###

# Tag catalog (key + camelCase category), in catalog order
GET {{RecipEBook.Api_HostAddress}}/api/tags

###

# Create a recipe → 201 Created, Location header and { "id": … }
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Omelette aux herbes",
  "servings": 2,
  "prepTimeMinutes": 5,
  "cookTimeMinutes": 5,
  "ingredients": [
    { "name": "œufs", "quantity": 3 },
    { "name": "ciboulette", "quantity": 0.5, "unit": "botte" }
  ],
  "steps": ["Battre les œufs.", "Cuire à feu doux."],
  "tags": ["quick", "vegetarian", "eggs"]
}

###

# Invalid recipe → 400 with the validation errors
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": " ",
  "servings": 0,
  "ingredients": [{ "name": "", "quantity": -1 }],
  "steps": [""]
}

###

# Replace a whole recipe (replace the id) → 204; fields left out become empty; unknown id → 404
PUT {{RecipEBook.Api_HostAddress}}/api/recipes/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Omelette aux fines herbes",
  "servings": 1,
  "ingredients": [{ "name": "œufs", "quantity": 2 }],
  "steps": ["Battre les œufs avec les herbes.", "Cuire 4 minutes à feu doux."],
  "tags": ["quick", "eggs", "breakfast"]
}

###

# Delete a recipe (replace the id) → 204; already deleted or unknown id → 404
DELETE {{RecipEBook.Api_HostAddress}}/api/recipes/00000000-0000-0000-0000-000000000000

###

# Tag outside the catalog → 400 "Unknown tag"
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Test",
  "tags": ["vegetarian", "not-a-tag"]
}

###

# Same in French (Accept-Language) → 400 "Tag inconnu"
POST {{RecipEBook.Api_HostAddress}}/api/recipes
Content-Type: application/json
Accept-Language: fr

{
  "title": "Test",
  "tags": ["vegetarian", "not-a-tag"]
}

###

# --- Shopping lists ---

# Lists with their item and checked counts, most recently updated first
GET {{RecipEBook.Api_HostAddress}}/api/shopping-lists
Accept: application/json

###

# Create a list → 201 + Location (copy the id for the requests below)
POST {{RecipEBook.Api_HostAddress}}/api/shopping-lists
Content-Type: application/json

{
  "name": "Courses de la semaine"
}

###

# One list with its items (replace the id)
GET {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000
Accept: application/json

###

# Rename a list → 204
PUT {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Anniversaire"
}

###

# Add a free item → 201 with its id
POST {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000/items
Content-Type: application/json

{
  "name": "lait",
  "quantity": 1,
  "unit": "l"
}

###

# Check an item (the whole item is sent) → 204; an item of another list → 404
PUT {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000/items/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "lait",
  "quantity": 1,
  "unit": "l",
  "checked": true
}

###

# Add a recipe's ingredients, for 2 servings → 200 { itemsAdded }
POST {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000/recipes
Content-Type: application/json

{
  "recipeId": "00000000-0000-0000-0000-000000000000",
  "servings": 2
}

###

# Remove the checked items → 204
DELETE {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000/checked-items

###

# Remove an item → 204
DELETE {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000/items/00000000-0000-0000-0000-000000000000

###

# Delete a list and its items → 204
DELETE {{RecipEBook.Api_HostAddress}}/api/shopping-lists/00000000-0000-0000-0000-000000000000

###
